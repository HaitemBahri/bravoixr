---
/* Component — Card
 * Gap-override on daisyUI's own .card: daisyUI supplies display:flex /
 * flex-direction:column and, once themed, the corner radius via --radius-box.
 * bravoixr fills only the taste gaps its base .card leaves unset — it carries
 * no padding, background or text colour of its own. Resting raised surface:
 * borderless, with the raised fill alone separating it from the page — no
 * border, no shadow.
 *
 * The rented .card class is load-bearing, not cosmetic: CardFooter's
 * margin-block-start:auto pin depends on the flex column it establishes, and
 * CardImage's corner rounding comes from daisyUI's own figure:first-child rules.
 *
 * `side` adds daisyUI's .card-side (flex-direction:row; align-items:stretch),
 * putting CardImage beside the content instead of above it. Being a flex row it
 * mirrors automatically under RTL — image at the inline start, left in LTR and
 * right in RTL — so no physical left/right appears anywhere. Card owns this
 * class because it is card-level; CardImage reads it off the ancestor. */

interface Props {
  /* Explicit `| undefined` — tsconfig extends astro/tsconfigs/strictest, where
   * exactOptionalPropertyTypes means `?` alone does not admit undefined. */
  side?: boolean | undefined;
}

const { side = false } = Astro.props;
---

<div class:list={['card', side && 'card-side']}>
  <slot />
</div>

<style>
  .card {
    padding: var(--bravoixr-spacing-5);
    background: var(--bravoixr-color-surface-raised);
    color: var(--bravoixr-color-text);
  }
</style>
