---
/* Component — PageFooterColumnItem
 * One entry inside a PageFooterColumn. With an href it renders a link wearing
 * daisyUI's own .link/.link-hover; without one it renders plain text — so the
 * same component serves a link nav and a copyright or version line, and no
 * column has to fall back to hand-written markup.
 *
 * Items are flat siblings of the column's title, not a <ul>/<li> list. daisyUI's
 * column grid turns each direct child into a grid row, so a list wrapper would
 * collapse to a single row and then need its own grid plus a list-style reset —
 * reimplementing mechanics that are already rented. The accepted trade-off is
 * that a link nav is a set of sibling <a>s rather than a semantic list, which is
 * what the markup did before the migration. (`display: contents` on the <ul> is
 * not a way out: it strips list semantics in several browsers, costing the very
 * thing it would be added for.)
 *
 * No styling of its own — the column's rented grid handles the spacing. */

interface Props {
  /* Explicit `| undefined` — tsconfig extends astro/tsconfigs/strictest, where
   * exactOptionalPropertyTypes means `?` alone does not admit undefined. */
  href?: string | undefined;
}

const { href } = Astro.props;

const Tag = href ? 'a' : 'span';
/* undefined attributes are omitted from the rendered element, so the plain-text
 * case emits a bare <span>. */
const linkClass = href ? 'link link-hover' : undefined;
---

<Tag class={linkClass} href={href}>
  <slot />
</Tag>