---
/* Component — ContainerStack
 * Arranges its children along one axis and wraps to a new line when space runs
 * out. `align-items: start` keeps each child at its own cross-axis size, so a
 * stack of unequal children stays ragged rather than stretching them all to
 * match the largest.
 *
 * `axis` defaults to row, the far more common case, so most call sites are a
 * bare <ContainerStack>.
 *
 * No block-size is declared — height is the ancestor's responsibility. This
 * matters for the column axis: flex-direction:column with flex-wrap:wrap only
 * starts a second column when the container's block-size is *definite*. In an
 * auto-height context the container simply grows and the wrap never engages,
 * which is correct behaviour rather than a bug to work around. The constraint
 * arrives naturally when the stack is a grid cell with a definite row, a flex
 * item stretched by its parent, or sits under an explicit height. Declaring
 * block-size: 100% here would be wrong — it would also force a row stack to
 * fill its parent's height.
 *
 * Flow-relative by construction: flex-direction row/column mirrors under RTL on
 * its own, so no physical left/right appears here.
 *
 * The axis reaches the CSS through a data attribute rather than a class: a
 * class would be a public selector a consumer could target, which the
 * encapsulation rule forbids, while the attribute compiles into a scoped
 * selector alongside this component's own hash. See CLAUDE.md. */

interface Props {
  /* Explicit `| undefined` — tsconfig extends astro/tsconfigs/strictest, where
   * exactOptionalPropertyTypes means `?` alone does not admit undefined. */
  axis?: 'row' | 'column' | undefined;
}

const { axis = 'row' } = Astro.props;
---

<div data-axis={axis}>
  <slot />
</div>

<style>
  div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bravoixr-spacing-5);
    align-items: start;
  }

  div[data-axis='column'] {
    flex-direction: column;
  }
</style>
