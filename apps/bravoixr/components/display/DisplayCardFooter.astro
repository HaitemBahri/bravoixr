---
/* Component — DisplayCardFooter
 * The card's action row: a flex row pinned to the card's bottom edge, with its
 * contents packed to the inline end.
 *
 * justify-content: flex-end is flow-relative inside a flex container, so it
 * mirrors under RTL with no physical left/right.
 *
 * margin-block-start: auto pins the row to the card's bottom edge when the card
 * is taller than its content. That depends on DisplayCard being a flex column,
 * and it only works when DisplayCardFooter is the *last child*. Placed anywhere
 * else the pin silently does nothing. Enforcing that would mean DisplayCard
 * owning the position through a named slot, which would cost the flat
 * composition this API is built around; it is left as a convention instead. */
---

<footer>
  <slot />
</footer>

<style>
  footer {
    display: flex;
    gap: var(--bravoixr-spacing-3);
    justify-content: flex-end;
    margin-block-start: auto;
    padding-block-start: var(--bravoixr-spacing-4);
  }
</style>
