---
/* Component — PageFooterColumnItem
 * One entry inside a PageFooterColumn. With an href it renders a link; without
 * one it renders plain text — so the same component serves a link nav and a
 * copyright or version line, and no column has to fall back to hand-written
 * markup.
 *
 * Items are flat siblings of the column's title, not a <ul>/<li> list. The
 * column is a grid, so each direct child is already a row; a list wrapper would
 * collapse to a single row and then need its own grid plus a list-style reset.
 * The accepted trade-off is that a link nav is a set of sibling <a>s rather
 * than a semantic list. (`display: contents` on the <ul> is not a way out: it
 * strips list semantics in several browsers, costing the very thing it would be
 * added for.)
 *
 * The link rests without an underline and gains one on hover, so a column of
 * links reads as text rather than as a block of rules. Colour is inherited
 * rather than set to a link role — the footer's own text colour already carries
 * the right contrast against the sunken fill, and a distinct link colour would
 * fight the muted register the column titles establish.
 *
 * :focus-visible is explicit. With no CSS reset in the library, the only focus
 * ring is the browser default, which varies and disappears entirely against
 * some backgrounds; the border-focus role is the system's own answer. */

interface Props {
  /* Explicit `| undefined` — tsconfig extends astro/tsconfigs/strictest, where
   * exactOptionalPropertyTypes means `?` alone does not admit undefined. */
  href?: string | undefined;
}

const { href } = Astro.props;

const Tag = href ? 'a' : 'span';
---

<Tag href={href}>
  <slot />
</Tag>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  a:focus-visible {
    outline: var(--bravoixr-border-width-strong) solid var(--bravoixr-color-border-focus);
    outline-offset: var(--bravoixr-spacing-1);
  }
</style>
