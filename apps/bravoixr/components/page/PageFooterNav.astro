---
/* Component — PageFooterNav
 * One nav column of the footer's main band: a title above a set of
 * PageFooterNavItem links. Takes the title as a required prop rather than a
 * slot so the structure is enforced — every column gets its heading in the
 * same place.
 *
 * Always a <nav>: brand and plain-text content now live in PageFooterBrand and
 * PageFooterBottom, so every column this component renders is navigation. A
 * footer usually holds several, alongside the header's PageNav, so each is
 * named by its title through aria-label — otherwise screen readers list a run
 * of identical "navigation" landmarks.
 *
 * The column is its own grid with place-items: start, which stacks the title
 * above the slotted items and keeps each one shrink-wrapped to its content
 * rather than stretched across the column — so a link's hover underline spans
 * the word, not the column width.
 *
 * The title is <h6> — the smallest heading, since a footer column label sits
 * below every structural heading on the page and should not compete with
 * PageSubSection's <h3> in the document outline. */

/* A text prop may carry one script or both — see PageSection for the full note.
 * Redeclared here rather than imported: the library has no cross-component
 * imports, and SpacingStep is duplicated across the layout family likewise. */
type BilingualText = string | { en: string; ar: string };

interface Props {
  title: BilingualText;
}

const { title } = Astro.props;

/* aria-label is an attribute, so it cannot hold the two switching spans the
 * heading uses — an attribute has no box for CSS to drop. It therefore takes
 * the Latin string and stays fixed in both directions. That is a deliberate
 * degradation, not an oversight: the label exists to tell one footer landmark
 * from another, so a fixed name still disambiguates them, and the column's
 * visible heading does switch. Any future attribute prop has the same ceiling. */
const label = typeof title === 'string' ? title : title.en;
---

<nav aria-label={label}>
  <h6>
    {
      typeof title === 'string' ? (
        title
      ) : (
        <>
          <span data-script="latin" lang="en">
            {title.en}
          </span>
          <span data-script="arabic" lang="ar">
            {title.ar}
          </span>
        </>
      )
    }
  </h6>
  <slot />
</nav>

<style>
  nav {
    display: grid;
    place-items: start;
    gap: var(--bravoixr-spacing-3);
  }

  /* Uppercase with the widened tracking the uppercase role carries — small caps
   * set solid read as a cramped block without it. Muted so the column labels
   * sit behind their contents rather than competing with them. */
  h6 {
    font-family: var(--bravoixr-font-heading);
    font-size: var(--bravoixr-text-label);
    font-weight: var(--bravoixr-weight-label);
    letter-spacing: var(--bravoixr-tracking-uppercase);
    text-transform: uppercase;
    color: var(--bravoixr-color-text-muted);
    margin-block: 0;
  }

  /* Script switching — see PageSection for why the spans carry no dir. */
  span[data-script="latin"] {
    display: var(--bravoixr-script-latin);
  }

  span[data-script="arabic"] {
    display: var(--bravoixr-script-arabic);
  }
</style>
