---
/* Component — PageSection
 * A top-level section of the page canvas — carries the block rhythm that
 * separates one section from the next, and owns its own heading and lede.
 *
 * Title and description are props rather than slotted markup so the structure
 * is enforced: every section puts its heading in the same place, at the same
 * level, with the same typography. Both are optional and independent — a
 * section that is pure content stays valid, and nothing is rendered for an
 * absent prop.
 *
 * The heading level is fixed at <h2>: the component name encodes the tier, and
 * PageSubSection takes <h3> below it. No level prop until a real case needs one.
 *
 * The description takes body type plus a muted colour and a capped measure — a
 * section lede is body copy, not page-level intro text, but it still wants a
 * capped line length.
 *
 * margin-block: 0 is declared on the description rather than assumed. The
 * library ships no reset, so a <p> would otherwise take the browser's own block
 * margins.
 *
 * Nothing rendered here carries a class: a class in the DOM is a public
 * selector a consumer could target. Bare element selectors plus Astro's scoping
 * keep every rule below reachable only through this component. Slotted content
 * never carries the scope attribute, so a consumer's own <p> in the slot is
 * untouched by the description rule. */

/* A text prop may carry one script or both. A plain string is script-agnostic
 * and renders as-is under either direction; a pair renders both scripts and
 * lets the --bravoixr-script-* roles drop the one that does not match dir, so
 * the swap costs no reload and no JavaScript. Redeclared here rather than
 * imported: the library has no cross-component imports, and SpacingStep is
 * duplicated across the layout family for the same reason. */
type BilingualText = string | { en: string; ar: string };

interface Props {
  /* Explicit `| undefined` — tsconfig extends astro/tsconfigs/strictest, where
   * exactOptionalPropertyTypes means `?` alone does not admit undefined. */
  title?: BilingualText | undefined;
  description?: BilingualText | undefined;
}

const { title, description } = Astro.props;
---

<section>
  {
    title && (
      <h2>
        {typeof title === 'string' ? (
          title
        ) : (
          <>
            <span data-script="latin" lang="en">{title.en}</span>
            <span data-script="arabic" lang="ar">{title.ar}</span>
          </>
        )}
      </h2>
    )
  }
  {
    description && (
      <p>
        {typeof description === 'string' ? (
          description
        ) : (
          <>
            <span data-script="latin" lang="en">{description.en}</span>
            <span data-script="arabic" lang="ar">{description.ar}</span>
          </>
        )}
      </p>
    )
  }
  <slot />
</section>

<style>
  section {
    margin-block-end: var(--bravoixr-spacing-10);
  }

  h2 {
    font-family: var(--bravoixr-font-heading);
    font-size: var(--bravoixr-text-section-title);
    font-weight: var(--bravoixr-weight-section-title);
    line-height: var(--bravoixr-leading-display);
    letter-spacing: var(--bravoixr-tracking-display);
    margin-block: 0 var(--bravoixr-spacing-4);
  }

  p {
    font-family: var(--bravoixr-font-body);
    font-size: var(--bravoixr-text-body);
    font-weight: var(--bravoixr-weight-body);
    line-height: var(--bravoixr-leading-prose);
    letter-spacing: var(--bravoixr-tracking-prose);
    max-inline-size: var(--bravoixr-measure-page-description);
    color: var(--bravoixr-color-text-muted);
    margin-block: 0;
  }

  /* Script switching. The roles resolve from the ambient dir, so exactly one
   * span is `contents` (its box dropped, text laid out as a direct child of the
   * heading or paragraph) and the other is `none`. The spans must never carry a
   * dir of their own: that would re-resolve these roles from the span's own
   * [dir] block, so it would compute `contents` for itself and never hide. */
  span[data-script="latin"] {
    display: var(--bravoixr-script-latin);
  }

  span[data-script="arabic"] {
    display: var(--bravoixr-script-arabic);
  }
</style>