---
// Demo page for the migrated page components. Grows as each component lands.
// Order matters: daisyUI (layered) first, then bravoixr (unlayered), which
// always wins regardless of load order.
import '../styles/global.css';
import 'bravoixr-astro/index.css';
import Page from 'bravoixr-astro/components/page/Page.astro';
import PageBody from 'bravoixr-astro/components/page/PageBody.astro';
import PageHeader from 'bravoixr-astro/components/page/PageHeader.astro';
import PageSection from 'bravoixr-astro/components/page/PageSection.astro';
import PageSubSection from 'bravoixr-astro/components/page/PageSubSection.astro';
import PageFooter from 'bravoixr-astro/components/page/PageFooter.astro';
import PageFooterColumn from 'bravoixr-astro/components/page/PageFooterColumn.astro';
import PageFooterColumnItem from 'bravoixr-astro/components/page/PageFooterColumnItem.astro';
import ContainerStack from 'bravoixr-astro/components/container/ContainerStack.astro';
import ContainerGrid from 'bravoixr-astro/components/container/ContainerGrid.astro';
import Card from 'bravoixr-astro/components/Card.astro';
import CardImage from 'bravoixr-astro/components/CardImage.astro';
import CardTitleBadge from 'bravoixr-astro/components/CardTitleBadge.astro';
import CardTitle from 'bravoixr-astro/components/CardTitle.astro';
import CardText from 'bravoixr-astro/components/CardText.astro';
import CardFooter from 'bravoixr-astro/components/CardFooter.astro';

// Same placeholder artwork the existing preview uses for its card-media demos.
const placeholder =
  "data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20320%20180%27%3E%3Crect%20width%3D%27320%27%20height%3D%27180%27%20fill%3D%27%23dfe3e8%27/%3E%3Ccircle%20cx%3D%27118%27%20cy%3D%2766%27%20r%3D%2715%27%20fill%3D%27%23b3bbc6%27/%3E%3Cpath%20d%3D%27M36%20152%20L118%2092%20L168%20126%20L214%2084%20L284%20152%20Z%27%20fill%3D%27%23b3bbc6%27/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>bravoixr — preview (Astro)</title>

    <!-- Pre-paint: apply stored theme/lang before first paint (no flash). -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('bravoixr-theme') || 'light';
        var l = localStorage.getItem('bravoixr-lang') || 'en';
        var r = document.documentElement;
        r.setAttribute('data-theme', t);
        if (l === 'ar') { r.setAttribute('dir', 'rtl'); r.setAttribute('lang', 'ar'); }
        else { r.setAttribute('dir', 'ltr'); r.setAttribute('lang', 'en'); }
      })();
    </script>

    <!-- Fonts: loaded by the preview (the consumer), never by the system CSS. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=IBM+Plex+Sans+Arabic:wght@200;300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
  </head>

  <Page>
    <PageHeader>
      <span slot="start">bravoixr</span>
      <span slot="center">Welcome</span>
      <button slot="end" class="btn btn-primary" type="button">Action</button>
    </PageHeader>

    <PageBody>
      <PageSection
        title="Design Tokens"
        description="The two token tiers the system is built from. Primitives hold the raw values; semantics give them meaning, and are the only tier components are allowed to read."
      >
        <PageSubSection
          title="Primitives"
          description="Raw literal values with no meaning attached — the portable source of truth, exported as-is and never consumed directly."
        />

        <PageSubSection
          title="Semantics"
          description="Meaning mapped onto primitives. The single seam components reference, and where every context switch — theme, script, viewport — is resolved."
        />
      </PageSection>

      <PageSection
        title="Previews"
        description="Rendered specimens of each component, shown in both themes and both reading directions."
      >
        <Card>
          <CardImage src={placeholder} alt="" />
          <CardTitleBadge>New</CardTitleBadge>
          <CardTitle>Card title</CardTitle>
          <CardText>Full-bleed media above the content.</CardText>
          <CardText>A second line, exercising the repeating case.</CardText>
          <CardFooter>
            <button class="btn btn-ghost" type="button">Cancel</button>
            <button class="btn btn-primary" type="button">Save</button>
          </CardFooter>
        </Card>

        <Card side>
          <CardImage src={placeholder} alt="" />
          <CardTitle>Card title</CardTitle>
          <CardText>Media beside the content, at the inline start.</CardText>
        </Card>

        <PageSubSection
          title="ContainerStack — row"
          description="Wraps to a new line when inline space runs out. Narrow the window to see it."
        >
          <ContainerStack>
            {Array.from({ length: 9 }, (_, i) => <span class="specimen">{i + 1}</span>)}
          </ContainerStack>
        </PageSubSection>

        <PageSubSection
          title="ContainerStack — column, unbounded"
          description="With no height constraint the stack grows and never wraps, however many children it holds."
        >
          <ContainerStack axis="column">
            {Array.from({ length: 5 }, (_, i) => <span class="specimen">{i + 1}</span>)}
          </ContainerStack>
        </PageSubSection>

        <PageSubSection
          title="ContainerStack — column, bounded"
          description="The same stack inside an ancestor that caps its height. Now it wraps into a second column."
        >
          <div class="bounded">
            <ContainerStack axis="column">
              {Array.from({ length: 5 }, (_, i) => <span class="specimen">{i + 1}</span>)}
            </ContainerStack>
          </div>
        </PageSubSection>

        <PageSubSection
          title="ContainerGrid"
          description="Columns are decided by the available width, not by the consumer. Narrow the window and the count drops, down to one."
        >
          <ContainerGrid>
            {Array.from({ length: 8 }, (_, i) => <div class="cell">{i + 1}</div>)}
          </ContainerGrid>
        </PageSubSection>
      </PageSection>
    </PageBody>

    <PageFooter>
      <PageFooterColumn title="bravoixr">
        <PageFooterColumnItem>Copyright © 2026 - All right reserved</PageFooterColumnItem>
      </PageFooterColumn>

      <PageFooterColumn title="Version">
        <PageFooterColumnItem>v0.4.5</PageFooterColumnItem>
      </PageFooterColumn>

      <PageFooterColumn title="Explore" nav>
        <PageFooterColumnItem href="#primitives">Primitives</PageFooterColumnItem>
        <PageFooterColumnItem href="#semantics">Semantics</PageFooterColumnItem>
      </PageFooterColumn>
    </PageFooter>
  </Page>
</html>

<style>
  /* Demo chrome — consumer-side only, never part of the system. Semantic tokens
   * are the supported escape hatch for exactly this: layout and one-offs no
   * component covers. */

  /* A plain specimen so the stack's arrangement is what you actually see. */
  .specimen {
    display: grid;
    place-items: center;
    inline-size: var(--bravoixr-demo-box-size);
    block-size: var(--bravoixr-demo-box-size);
    background: var(--bravoixr-color-surface-raised);
    border-radius: var(--bravoixr-radius-card);
  }

  /* The ancestor that supplies the height ContainerStack deliberately does not
   * declare — three specimens plus two gaps, so the fourth has to wrap.
   *
   * display:flex matters as much as the height: a plain block with a height
   * would not constrain its child at all, and the stack would simply overflow
   * it. As a flex item the stack is stretched to the container's block-size by
   * the default align-items:stretch, which is what makes its own height
   * definite and lets the wrap engage. */
  .bounded {
    display: flex;
    block-size: calc(3 * var(--bravoixr-demo-box-size) + 2 * var(--bravoixr-spacing-5));
  }

  /* A grid cell specimen — takes the column width the grid gives it, so the
   * reflow is what you see rather than the cell's own sizing. */
  .cell {
    display: grid;
    place-items: center;
    block-size: var(--bravoixr-demo-box-size);
    background: var(--bravoixr-color-surface-raised);
    border-radius: var(--bravoixr-radius-card);
  }
</style>
