---
// Demo page for the page components. Grows as each component lands.
import 'bravoixr/index.css';
import Page from 'bravoixr/components/page/Page.astro';
import PageHeader from 'bravoixr/components/page/PageHeader.astro';
import PageBrand from 'bravoixr/components/page/PageBrand.astro';
import PageMain from 'bravoixr/components/page/PageMain.astro';
import PageMainContainer from 'bravoixr/components/page/PageMainContainer.astro';
import PageSection from 'bravoixr/components/page/PageSection.astro';
import PageSubSection from 'bravoixr/components/page/PageSubSection.astro';
import PageFooter from 'bravoixr/components/page/PageFooter.astro';
import PageFooterMain from 'bravoixr/components/page/PageFooterMain.astro';
import PageFooterBrand from 'bravoixr/components/page/PageFooterBrand.astro';
import PageFooterNav from 'bravoixr/components/page/PageFooterNav.astro';
import PageFooterNavItem from 'bravoixr/components/page/PageFooterNavItem.astro';
import PageFooterBottom from 'bravoixr/components/page/PageFooterBottom.astro';
import ContainerGrid from 'bravoixr/components/container/ContainerGrid.astro';
import DisplayCard from 'bravoixr/components/display/DisplayCard.astro';
import DisplayCardTitle from 'bravoixr/components/display/DisplayCardTitle.astro';
import DisplayCardText from 'bravoixr/components/display/DisplayCardText.astro';

---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>bravoixr — preview (Astro)</title>

    <!-- Pre-paint: apply stored theme/lang before first paint (no flash). -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('bravoixr-theme') || 'light';
        var l = localStorage.getItem('bravoixr-lang') || 'en';
        var r = document.documentElement;
        r.setAttribute('data-theme', t);
        if (l === 'ar') { r.setAttribute('dir', 'rtl'); r.setAttribute('lang', 'ar'); }
        else { r.setAttribute('dir', 'ltr'); r.setAttribute('lang', 'en'); }
      })();
    </script>

    <!-- Fonts: loaded by the preview (the consumer), never by the system CSS. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=IBM+Plex+Sans+Arabic:wght@200;300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
  </head>

  <Page>
    <PageHeader>
      <PageBrand>bravoixr</PageBrand>
    </PageHeader>

    <PageMain>
      <PageMainContainer
        title="Design identity preview"
        description="bravoixr's tokens and components, rendered through the Astro component library."
      >
        <PageSection
          title="Design Tokens"
        >
          <PageSubSection
            title="Primitives"
          >
            <ContainerGrid>
              <DisplayCard>
                <DisplayCardTitle>Color</DisplayCardTitle>
                <DisplayCardText>Brand, status, and accent ramps plus neutrals.</DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>Typography</DisplayCardTitle>
                <DisplayCardText>Font stacks, size scales, weights, leading, tracking.</DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>Layout</DisplayCardTitle>
                <DisplayCardText>Spacing, sizing, radius, borders, shadows, z-index.</DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>Icons</DisplayCardTitle>
                <DisplayCardText>Icon font, variable axes, and size scale.</DisplayCardText>
              </DisplayCard>
            </ContainerGrid>
          </PageSubSection>

          <PageSubSection
            title="Semantics"
          >
            <ContainerGrid>
              <DisplayCard>
                <DisplayCardTitle>Color</DisplayCardTitle>
                <DisplayCardText>
                  Role tokens for brand, status, surfaces, text, and borders — themed light/dark.
                </DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>Typography</DisplayCardTitle>
                <DisplayCardText>
                  Family, size, weight, leading, and tracking roles — scripted and responsive.
                </DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>Layout</DisplayCardTitle>
                <DisplayCardText>Radius, border, sizing, shadow, layer, and spacing roles.</DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>Icons</DisplayCardTitle>
                <DisplayCardText>Family, axis, and size roles — with a theme-aware grade.</DisplayCardText>
              </DisplayCard>
            </ContainerGrid>
          </PageSubSection>
        </PageSection>

        <PageSection
          title="Previews"
        />
      </PageMainContainer>
    </PageMain>

    <PageFooter>
      <PageFooterMain>
        <PageFooterBrand>bravoixr</PageFooterBrand>

        <PageFooterNav title="Explore">
          <PageFooterNavItem href="#primitives">Primitives</PageFooterNavItem>
          <PageFooterNavItem href="#semantics">Semantics</PageFooterNavItem>
        </PageFooterNav>
      </PageFooterMain>

      <PageFooterBottom>
        <span>Copyright © 2026 - All right reserved</span>
        <span>v0.4.5</span>
      </PageFooterBottom>
    </PageFooter>
  </Page>
</html>

