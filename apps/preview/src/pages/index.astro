---
// Demo page for the page components. Grows as each component lands.
import 'bravoixr/index.css';
import Page from 'bravoixr/components/page/Page.astro';
import PageHeader from 'bravoixr/components/page/PageHeader.astro';
import PageBrand from 'bravoixr/components/page/PageBrand.astro';
import PageMain from 'bravoixr/components/page/PageMain.astro';
import PageMainContainer from 'bravoixr/components/page/PageMainContainer.astro';
import PageSection from 'bravoixr/components/page/PageSection.astro';
import PageSubSection from 'bravoixr/components/page/PageSubSection.astro';
import PageFooter from 'bravoixr/components/page/PageFooter.astro';
import PageFooterMain from 'bravoixr/components/page/PageFooterMain.astro';
import PageFooterBrand from 'bravoixr/components/page/PageFooterBrand.astro';
import PageFooterNav from 'bravoixr/components/page/PageFooterNav.astro';
import PageFooterNavItem from 'bravoixr/components/page/PageFooterNavItem.astro';
import PageFooterBottom from 'bravoixr/components/page/PageFooterBottom.astro';
import LayoutGrid from 'bravoixr/components/layout/LayoutGrid.astro';
import DisplayCard from 'bravoixr/components/display/DisplayCard.astro';
import DisplayCardTitle from 'bravoixr/components/display/DisplayCardTitle.astro';
import DisplayCardText from 'bravoixr/components/display/DisplayCardText.astro';
import DisplayBilingual from 'bravoixr/components/display/DisplayBilingual.astro';

// Text props take { en, ar }; slots take <DisplayBilingual>. Both ship the two
// scripts and let the --bravoixr-script-* roles drop the one that does not
// match dir, so the page swaps language with no reload.
//
// "bravoixr" and the version number stay plain strings — a proper noun and a
// numeral read the same in both scripts, and a plain string renders under
// either direction by design.
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>bravoixr — preview (Astro)</title>

    <!-- Pre-paint: apply stored theme/lang before first paint (no flash). -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('bravoixr-theme') || 'light';
        var l = localStorage.getItem('bravoixr-lang') || 'en';
        var r = document.documentElement;
        r.setAttribute('data-theme', t);
        if (l === 'ar') { r.setAttribute('dir', 'rtl'); r.setAttribute('lang', 'ar'); }
        else { r.setAttribute('dir', 'ltr'); r.setAttribute('lang', 'en'); }
      })();
    </script>

    <!-- Fonts: loaded by the preview (the consumer), never by the system CSS. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=IBM+Plex+Sans+Arabic:wght@200;300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
  </head>

  <Page>
    <PageHeader>
      <PageBrand>bravoixr</PageBrand>
    </PageHeader>

    <PageMain>
      <PageMainContainer
        title={{ en: 'Design identity preview', ar: 'معاينة الهوية البصرية' }}
        description={{
          en: "bravoixr's tokens and components, rendered through the Astro component library.",
          ar: 'رموز bravoixr ومكوّناتها، معروضة عبر مكتبة مكوّنات Astro.',
        }}
      >
        <PageSection title={{ en: 'Design Tokens', ar: 'رموز التصميم' }}>
          <PageSubSection title={{ en: 'Primitives', ar: 'القيم الأولية' }}>
            <LayoutGrid>
              <DisplayCard>
                <DisplayCardTitle>
                  <DisplayBilingual en="Color" ar="اللون" />
                </DisplayCardTitle>
                <DisplayCardText>
                  <DisplayBilingual
                    en="Brand, status, and accent ramps plus neutrals."
                    ar="تدرّجات الهوية والحالات والتمييز، إضافة إلى المحايدة."
                  />
                </DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>
                  <DisplayBilingual en="Typography" ar="الطباعة" />
                </DisplayCardTitle>
                <DisplayCardText>
                  <DisplayBilingual
                    en="Font stacks, size scales, weights, leading, tracking."
                    ar="عائلات الخطوط ومقاييس الأحجام والأوزان وتباعد الأسطر والحروف."
                  />
                </DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>
                  <DisplayBilingual en="Layout" ar="التخطيط" />
                </DisplayCardTitle>
                <DisplayCardText>
                  <DisplayBilingual
                    en="Spacing, sizing, radius, borders, shadows, z-index."
                    ar="المسافات والأحجام والاستدارة والحدود والظلال وترتيب الطبقات."
                  />
                </DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>
                  <DisplayBilingual en="Icons" ar="الأيقونات" />
                </DisplayCardTitle>
                <DisplayCardText>
                  <DisplayBilingual
                    en="Icon font, variable axes, and size scale."
                    ar="خط الأيقونات ومحاوره المتغيّرة ومقياس الأحجام."
                  />
                </DisplayCardText>
              </DisplayCard>
            </LayoutGrid>
          </PageSubSection>

          <PageSubSection title={{ en: 'Semantics', ar: 'الأدوار الدلالية' }}>
            <LayoutGrid>
              <DisplayCard>
                <DisplayCardTitle>
                  <DisplayBilingual en="Color" ar="اللون" />
                </DisplayCardTitle>
                <DisplayCardText>
                  <DisplayBilingual
                    en="Role tokens for brand, status, surfaces, text, and borders — themed light/dark."
                    ar="رموز الأدوار للهوية والحالات والأسطح والنص والحدود — بسمتين فاتحة وداكنة."
                  />
                </DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>
                  <DisplayBilingual en="Typography" ar="الطباعة" />
                </DisplayCardTitle>
                <DisplayCardText>
                  <DisplayBilingual
                    en="Family, size, weight, leading, and tracking roles — scripted and responsive."
                    ar="أدوار العائلة والحجم والوزن وتباعد الأسطر والحروف — متغيّرة بالخط ومستجيبة."
                  />
                </DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>
                  <DisplayBilingual en="Layout" ar="التخطيط" />
                </DisplayCardTitle>
                <DisplayCardText>
                  <DisplayBilingual
                    en="Radius, border, sizing, shadow, layer, and spacing roles."
                    ar="أدوار الاستدارة والحدود والأحجام والظلال والطبقات والمسافات."
                  />
                </DisplayCardText>
              </DisplayCard>

              <DisplayCard>
                <DisplayCardTitle>
                  <DisplayBilingual en="Icons" ar="الأيقونات" />
                </DisplayCardTitle>
                <DisplayCardText>
                  <DisplayBilingual
                    en="Family, axis, and size roles — with a theme-aware grade."
                    ar="أدوار العائلة والمحور والحجم — مع درجة تتبع السمة."
                  />
                </DisplayCardText>
              </DisplayCard>
            </LayoutGrid>
          </PageSubSection>
        </PageSection>

        <PageSection title={{ en: 'Previews', ar: 'المعاينات' }} />
      </PageMainContainer>
    </PageMain>

    <PageFooter>
      <PageFooterMain>
        <PageFooterBrand>bravoixr</PageFooterBrand>

        <PageFooterNav title={{ en: 'Explore', ar: 'استكشف' }}>
          <PageFooterNavItem href="#primitives">
            <DisplayBilingual en="Primitives" ar="القيم الأولية" />
          </PageFooterNavItem>
          <PageFooterNavItem href="#semantics">
            <DisplayBilingual en="Semantics" ar="الأدوار الدلالية" />
          </PageFooterNavItem>
        </PageFooterNav>
      </PageFooterMain>

      <PageFooterBottom>
        <span>
          <DisplayBilingual
            en="Copyright © 2026 - All right reserved"
            ar="حقوق النشر © 2026 - جميع الحقوق محفوظة"
          />
        </span>
        <span>v0.4.5</span>
      </PageFooterBottom>
    </PageFooter>
  </Page>
</html>
